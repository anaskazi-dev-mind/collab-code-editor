# =============================================================================
# Collaborative Code Editor — Environment Variables (template)
#
# Setup: cp .env.example .env   then fill in real values.
# .env is gitignored — never commit real secrets.
#
# Phase 0 scope note: only PostgreSQL and Redis run in Docker right now
# (infrastructure/docker/docker-compose.yml). apps/api and apps/execution-worker
# run directly on the host via `pnpm dev` and reach those containers through
# the mapped localhost ports below. This changes once those apps are
# themselves containerized in a later phase.
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# apps/api — HTTP + WebSocket server
# -----------------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# apps/execution-worker — exposes only a health/readiness endpoint;
# holds no app secrets (see docs/architecture.md, Section 7 isolation boundary)
# -----------------------------------------------------------------------------
EXECUTION_WORKER_PORT=4100

# -----------------------------------------------------------------------------
# apps/web — Vite only exposes env vars prefixed VITE_ to client-side code.
# Never put a secret behind a VITE_ prefix — it ends up in the browser bundle.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000

# -----------------------------------------------------------------------------
# PostgreSQL — read in two different ways, keep both in sync:
#   1. POSTGRES_* initializes the official postgres Docker image
#      (infrastructure/docker/docker-compose.yml).
#   2. DATABASE_URL is the single connection string Prisma reads
#      (apps/api/prisma/schema.prisma -> env("DATABASE_URL")).
# -----------------------------------------------------------------------------
POSTGRES_USER=collab_user
POSTGRES_PASSWORD=collab_dev_password
POSTGRES_DB=collab_code_editor
POSTGRES_PORT=5432
DATABASE_URL=postgresql://collab_user:collab_dev_password@localhost:5432/collab_code_editor?schema=public

# -----------------------------------------------------------------------------
# Redis — pub/sub fan-out, BullMQ queue store, presence cache, rate limiting
# (docs/architecture.md, Section 9). Empty password = no auth, local-dev only;
# production must set REDIS_PASSWORD and update REDIS_URL to match.
# -----------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Auth — JWT signing (Section 8). Generate real secrets with:
#   openssl rand -base64 48
# Never reuse these example values past local development.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

# -----------------------------------------------------------------------------
# OAuth providers (optional, Section 8). Leave blank to disable OAuth login —
# email/password auth works without these.
# -----------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Code execution sandbox limits (Section 7) — passed to the Docker runner.
# -----------------------------------------------------------------------------
EXECUTION_TIMEOUT_MS=10000
EXECUTION_MEMORY_LIMIT_MB=128
EXECUTION_CPU_LIMIT=0.5
EXECUTION_PIDS_LIMIT=64