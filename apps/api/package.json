{
  "name": "@collab/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST + WebSocket API server for the real-time collaborative code editor (Fastify, Prisma, Awilix, Zod).",
  "type": "module",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "awilix": "13.0.5",
    "fastify": "5.12.4",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.0",
    "dotenv": "17.4.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "vitest": "5.0.0"
  }
}